<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Barra superior del CLIENTE con sus menús desplegables. Es UNA sola para todas las pantallas del cliente:
  cada pantalla la incluye con  <fx:include source="BarraCliente.fxml" />  (al final, para quedar encima).
  pickOnBounds="false": las partes vacías de este panel no "tapan" los clics de la pantalla de abajo.
-->
<Pane fx:id="barraRaiz" pickOnBounds="false" prefHeight="104.0" prefWidth="1920.0" stylesheets="@inicio.css" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinemauq.cinemauq.viewController.BarraClienteViewController">
   <children>
         <!-- Barra superior del cliente: CinemaUQ (lleva al inicio), Formatos (despliega un menú al pasar
              el mouse, como en AMC), Mis entradas, Cerrar sesión y el saludo -->
         <Pane layoutX="86.0" layoutY="37.0" prefHeight="59.0" prefWidth="1776.0" style="-fx-background-color: #111111; -fx-background-radius: 54;">
            <children>
               <Button layoutX="6.0" layoutY="9.0" mnemonicParsing="false" onAction="#onAtras" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 22px; -fx-cursor: hand;" text="←" />
               <Button layoutX="48.0" layoutY="7.0" mnemonicParsing="false" onAction="#onHome" prefHeight="44.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 20px; -fx-cursor: hand;" text="CinemaUQ®" />
               <Button layoutX="470.0" layoutY="9.0" mnemonicParsing="false" onAction="#onCartelera" onMouseEntered="#onEntrarPeliculas" onMouseExited="#programarCierreMenu" prefHeight="40.0" styleClass="boton-barra" text="Películas ▾" />
               <Button layoutX="680.0" layoutY="9.0" mnemonicParsing="false" onAction="#onMasFormatos" onMouseEntered="#onEntrarFormatos" onMouseExited="#programarCierreMenu" prefHeight="40.0" styleClass="boton-barra" text="Formatos ▾" />
               <Button layoutX="890.0" layoutY="9.0" mnemonicParsing="false" onAction="#onVerCombos" onMouseEntered="#onEntrarCombos" onMouseExited="#programarCierreMenu" prefHeight="40.0" styleClass="boton-barra" text="Combos ▾" />
               <Button fx:id="btnMisEntradas" layoutX="1080.0" layoutY="9.0" mnemonicParsing="false" onAction="#onMisEntradas" prefHeight="40.0" styleClass="boton-barra" text="Mis entradas" />
               <Button layoutX="1270.0" layoutY="9.0" mnemonicParsing="false" onAction="#onCerrarSesion" prefHeight="40.0" styleClass="boton-barra" text="Cerrar sesión" />
               <!-- El saludo también despliega un menú: el plan del cliente y su cuenta -->
               <Pane layoutX="1530.0" onMouseEntered="#onEntrarCuenta" onMouseExited="#programarCierreMenu" prefHeight="59.0" prefWidth="246.0" style="-fx-background-color: #b81414; -fx-background-radius: 54; -fx-cursor: hand;">
                  <children>
                     <Label fx:id="lblSaludo" alignment="CENTER" layoutY="14.0" prefWidth="246.0" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px;" text="Hola ▾" />
                  </children>
               </Pane>
            </children>
         </Pane>
         <!-- Menú desplegable de Formatos (estilo AMC). Va al final para quedar ENCIMA de todo.
              Empieza oculto; aparece al pasar el mouse por "Formatos" y se esconde al salir. -->
         <HBox fx:id="menuFormatos" layoutX="0.0" layoutY="104.0" onMouseEntered="#cancelarCierreMenu" onMouseExited="#programarCierreMenu" prefWidth="1920.0" spacing="70.0" styleClass="menu-desplegable" visible="false">
            <padding><Insets bottom="50.0" left="190.0" right="120.0" top="50.0" /></padding>
            <children>
               <!-- Columna 1: el cine -->
               <VBox prefWidth="330.0" spacing="16.0">
                  <children>
                     <StackPane fx:id="marcoMenuImagen" prefHeight="230.0" prefWidth="320.0">
                        <children>
                           <ImageView fx:id="imgMenu" fitHeight="230.0" fitWidth="320.0" preserveRatio="true" />
                        </children>
                     </StackPane>
                     <Label fx:id="lblMenuCine" styleClass="menu-cine" text="CinemaUQ" wrapText="true" />
                     <Label fx:id="lblMenuDireccion" styleClass="menu-direccion" text="Armenia, Quindío" wrapText="true" />
                     <Button mnemonicParsing="false" onAction="#onVerHorarios" styleClass="boton-entradas" text="Ver horarios" />
                  </children>
               </VBox>
               <!-- Columna 2 -->
               <VBox spacing="22.0">
                  <children>
                     <Label styleClass="menu-titulo" text="Formatos premium" />
                     <Label onMouseClicked="#onFormatoMenu" styleClass="menu-enlace" text="IMAX en CinemaUQ" userData="IMAX" />
                     <Label onMouseClicked="#onFormatoMenu" styleClass="menu-enlace" text="IMAX 70 mm" userData="IMAX_70MM" />
                     <Label onMouseClicked="#onFormatoMenu" styleClass="menu-enlace" text="Dolby Cinema en CinemaUQ" userData="DOLBY_CINEMA" />
                     <Label onMouseClicked="#onFormatoMenu" styleClass="menu-enlace" text="4DX" userData="CUATRO_DX" />
                     <Label onMouseClicked="#onFormatoMenu" styleClass="menu-enlace" text="ScreenX" userData="SCREENX" />
                  </children>
               </VBox>
               <!-- Columna 3 -->
               <VBox spacing="22.0">
                  <children>
                     <Label styleClass="menu-titulo" text="Más formatos" />
                     <Label onMouseClicked="#onFormatoMenu" styleClass="menu-enlace" text="Signature" userData="DOS_D" />
                     <Label onMouseClicked="#onFormatoMenu" styleClass="menu-enlace" text="RealD 3D" userData="TRES_D" />
                     <Label onMouseClicked="#onFormatoMenu" styleClass="menu-enlace" text="Prime" userData="PRIME" />
                     <Label onMouseClicked="#onFormatoMenu" styleClass="menu-enlace" text="XD" userData="XD" />
                     <Label onMouseClicked="#onFormatoMenu" styleClass="menu-enlace" text="Infinity Vision" userData="INFINITY_VISION" />
                  </children>
               </VBox>
               <!-- Columna 4 -->
               <VBox spacing="22.0">
                  <children>
                     <Label styleClass="menu-titulo" text="Experiencias" />
                     <Label onMouseClicked="#onFormatoMenu" styleClass="menu-enlace" text="VIP Bistró" userData="VIP_BISTRO" />
                     <Label onMouseClicked="#onTodosLosFormatos" styleClass="menu-enlace" text="Todos los formatos" />
                     <Label onMouseClicked="#onCartelera" styleClass="menu-enlace" text="Ver la cartelera" />
                  </children>
               </VBox>
            </children>
         </HBox>

         <!-- Menú desplegable de Películas: la película destacada y la cartelera (lo llena el programa) -->
         <HBox fx:id="menuPeliculas" layoutX="0.0" layoutY="104.0" onMouseEntered="#cancelarCierreMenu" onMouseExited="#programarCierreMenu" prefWidth="1920.0" spacing="70.0" styleClass="menu-desplegable,menu-azul" visible="false">
            <padding><Insets bottom="50.0" left="190.0" right="120.0" top="50.0" /></padding>
            <children>
               <HBox spacing="24.0">
                  <children>
                     <StackPane fx:id="marcoMenuPelicula" prefHeight="300.0" prefWidth="200.0" style="-fx-background-color: rgba(0,0,0,0.25);">
                        <children>
                           <ImageView fx:id="imgMenuPelicula" fitHeight="300.0" fitWidth="200.0" preserveRatio="true" />
                        </children>
                     </StackPane>
                     <VBox maxWidth="300.0" spacing="14.0">
                        <children>
                           <Label styleClass="menu-direccion" text="DESTACADA" />
                           <Label fx:id="lblMenuPelicula" styleClass="menu-cine" text="Película" wrapText="true" />
                           <Label fx:id="lblMenuPeliculaDatos" styleClass="menu-direccion" text="Datos" wrapText="true" />
                           <Button fx:id="btnMenuEntradas" mnemonicParsing="false" onAction="#onEntradasDestacada" styleClass="boton-entradas" text="Obtener entradas" />
                        </children>
                     </VBox>
                  </children>
               </HBox>
               <VBox fx:id="columnaMenuCartelera" spacing="22.0">
                  <children>
                     <Label styleClass="menu-titulo" text="En cartelera" />
                  </children>
               </VBox>
               <VBox spacing="22.0">
                  <children>
                     <Label styleClass="menu-titulo" text="Explorar" />
                     <Label onMouseClicked="#onCartelera" styleClass="menu-enlace" text="Ver todas las películas" />
                     <Label onMouseClicked="#onVerHorarios" styleClass="menu-enlace" text="Horarios de todas las funciones" />
                     <Label onMouseClicked="#onMisEntradas" styleClass="menu-enlace" text="Mis entradas" />
                  </children>
               </VBox>
            </children>
         </HBox>

         <!-- Menú de la cuenta: sale debajo del saludo ("Hola, Laura ▾") -->
         <VBox fx:id="menuCuenta" layoutX="1556.0" layoutY="104.0" onMouseEntered="#cancelarCierreMenu" onMouseExited="#programarCierreMenu" prefWidth="306.0" spacing="18.0" styleClass="menu-desplegable,menu-cuenta,menu-morado" visible="false">
            <padding><Insets bottom="28.0" left="28.0" right="28.0" top="28.0" /></padding>
            <children>
               <Label styleClass="menu-titulo" text="Mi cuenta" />
               <Label fx:id="lblMenuPlan" styleClass="menu-direccion" text="Plan" wrapText="true" />
               <Label fx:id="lblMenuMisEntradas" onMouseClicked="#onMisEntradas" styleClass="menu-enlace" text="Mis entradas" />
               <Label fx:id="lblMenuPrincipal" onMouseClicked="#onMenuAdministrador" styleClass="menu-enlace" text="Menú del administrador" />
               <Label onMouseClicked="#onCerrarSesion" styleClass="menu-enlace" text="Cerrar sesión" />
            </children>
         </VBox>

         <!-- Menú desplegable de Combos (naranja): algunos combos y el enlace al catálogo completo -->
         <HBox fx:id="menuCombos" layoutX="0.0" layoutY="104.0" onMouseEntered="#cancelarCierreMenu" onMouseExited="#programarCierreMenu" prefWidth="1920.0" spacing="60.0" styleClass="menu-desplegable,menu-naranja" visible="false">
            <padding><Insets bottom="50.0" left="190.0" right="120.0" top="50.0" /></padding>
            <children>
               <HBox fx:id="filaMenuCombos" spacing="28.0" />
               <VBox spacing="22.0">
                  <children>
                     <Label styleClass="menu-titulo" text="Combos y snacks" />
                     <Label onMouseClicked="#onVerCombos" styleClass="menu-enlace" text="Ver todos los combos" />
                     <Label onMouseClicked="#onVerCombos" styleClass="menu-enlace" text="Exclusivos VIP Bistró" />
                     <Label onMouseClicked="#onCartelera" styleClass="menu-enlace" text="Ver la cartelera" />
                  </children>
               </VBox>
            </children>
         </HBox>
   </children>
</Pane>
